# 目标机部署配置示例：复制为 .env 后按需修改
# cp .env.deploy.example .env

# 控制台镜像（私有仓库示例：<harbor-host>:<port>/public/easytier-admin:latest）
ADMIN_IMAGE=easytier-admin:latest

# 控制台 Web 端口（宿主机端口 -> 容器 11211）
WEB_PORT=11211

# EasyTier 共享节点监听端口范围（需与 web 端口互不冲突）
LISTEN_PORT_START=11011
LISTEN_PORT_END=11029

# 数据持久化目录（相对或绝对路径）
DATA_DIR=./data

# 生产环境务必固定；生成：openssl rand -base64 48
APP_SECRET=

# 默认公共共享节点（可留空，由各网络自行配置初始 Peer）
EASYTIER_DEFAULT_EXTERNAL_NODE=tcp://public.easytier.cn:11010

# 每个网络实例的 RPC 门户起始端口（仅容器内部使用，无需对外暴露）
EASYTIER_RPC_PORT_START=15888

# 日志级别：trace|debug|info|warn|error
LOG_LEVEL=info

# 经 HTTPS 反向代理访问时设为 true
COOKIE_SECURE=false

# 时区
TZ=Asia/Shanghai
