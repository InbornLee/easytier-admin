# ===== EasyTier Admin 控制台配置 =====

# --- 服务 ---
# 前后端监听端口（生产环境同时提供前端静态资源与 API）
PORT=11211
HOST=0.0.0.0
NODE_ENV=production

# --- 数据目录 ---
# 数据库、网络配置、凭据文件、日志等都放在此目录
DATA_DIR=./data

# --- 安全 ---
# APP_SECRET 用于 JWT 签名与数据库敏感字段（network_secret / credential_secret）加密
# 留空时自动生成并持久化到 $DATA_DIR/.app_secret
APP_SECRET=
# 登录令牌有效期（秒）
JWT_TTL=86400
# 允许的跨域来源，多个用逗号分隔；生产同源可留空
CORS_ORIGIN=

# --- EasyTier 二进制 ---
# easytier-core / easytier-cli 可执行文件路径（可为绝对路径，或在 PATH 中）
EASYTIER_CORE_PATH=easytier-core
EASYTIER_CLI_PATH=easytier-cli
# 当控制台运行节点时的默认网络名/前端展示
EASYTIER_DEFAULT_EXTERNAL_NODE=tcp://public.easytier.cn:11010
# RPC 门户起始端口，每个网络实例自动分配 +1
EASYTIER_RPC_PORT_START=15888
# 监听端口起始端口
EASYTIER_LISTEN_PORT_START=11010

# --- 日志 ---
LOG_LEVEL=info

# --- Docker Compose ---
# 宿主机 Web 端口（容器内固定 11211）
WEB_PORT=11211
